{
  "name": "companion-mvp",
  "version": "0.3.1",
  "description": "A local companion for Codex Desktop, Feishu and Android capture.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "node --no-warnings src/main.mjs",
    "test": "node --no-warnings --test test/*.test.mjs",
