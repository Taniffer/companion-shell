    "test:bridge": "node --no-warnings --test bridge-kit/test/*.test.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
